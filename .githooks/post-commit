#!/usr/bin/env sh
set -eu

# Auto-tag each commit by bumping patch version.
# Uses latest tag matching vMAJOR.MINOR.PATCH; defaults to v0.0.0.

latest_tag=$(git tag --list 'v*' --sort=-v:refname | head -n 1 || true)

if [ -z "$latest_tag" ]; then
  major=0
  minor=0
  patch=0
else
  version=${latest_tag#v}
  IFS='.' read -r major minor patch <<EOF
$version
EOF
  : "${major:=0}" "${minor:=0}" "${patch:=0}"
fi

patch=$((patch + 1))
new_tag="v${major}.${minor}.${patch}"

# Avoid re-tagging if the tag already exists.
if git rev-parse -q --verify "refs/tags/${new_tag}" >/dev/null 2>&1; then
  exit 0
fi

git tag "${new_tag}"

# Optionally push tags if the user has a default remote configured.
if git remote | grep -q '^origin$'; then
  git push origin "${new_tag}" >/dev/null 2>&1 || true
fi
